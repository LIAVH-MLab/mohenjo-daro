{ "type": "Feature", "properties": { "field_1": 2514, "Plate": "105-055-X", "Block": 4, "House": 0, "Room": null, "Level_ft": -11.0, "Time_Cat": "Intermediate I", "Feature": "Cooking Baking Utensils", "Type": "Bone Implement", "Text": "The inner edge of this implement shows considerable wear on both faces and bears a number of fine, oblique lines. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 2515, "Plate": "109-037-X", "Block": 10, "House": 1, "Room": "5", "Level_ft": -12.6, "Time_Cat": "Intermediate I", "Feature": "Household Objects", "Type": "Palettes", "Text": "A plain circular disc of soft, white alabaster, slightly convex on one side and concave on the other. It may have been used as a palette, though the nature of the stone would hardly permit of hard grinding being done upon it. ", "N1": "Artefacts", "Class": "Other", "photo": null, "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-5" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
