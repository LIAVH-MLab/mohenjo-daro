{
"type": "FeatureCollection",
"name": "Processed_Data_2025_update",
"crs": { "type": "name", "properties": { "name": "urn:ogc:def:crs:OGC:1.3:CRS84" } },
"features": [
{ "type": "Feature", "properties": { "field_1": 10, "Plate": "074-011-X", "Block": 9, "House": 10, "Room": "85", "Level_ft": -6.6, "Time_Cat": "Late II", "Feature": "Animals", "Type": "Model animal", "Text": "Shell. A very carefully carved bull''s head with sockets for the eyes, ears and horns, which were doubtless made of some rare material afterwards removed. This head was probably cemented by the flat surface at the back to a body.  ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/074-011-x.png", "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-85" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 17, "Plate": "077-002-X", "Block": 7, "House": 7, "Room": "58", "Level_ft": -9.4, "Time_Cat": "Late III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a dark red slip. An animal with short straight horns which may have been intended to be an antelope, though it has a long tail. Round pellets for eyes but no other details of face or body shown. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-002-x.png", "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-58" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 18, "Plate": "077-003-X", "Block": 9, "House": 10, "Room": "83", "Level_ft": -5.2, "Time_Cat": "Late II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with no slip nor traces of colour. With its downward drooped wings, this may represent a dove. Two holes in the base of the figure just below the neck evidently took small peg legs. Very careful work as though made in a mould and touched up afterwards. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-003-x.png", "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-83" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 21, "Plate": "056-054-X", "Block": 10, "House": 2, "Room": "26", "Level_ft": -11.1, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/056-054-x.png", "x": 68.136967570207489, "y": 27.326793023227424, "j_id": "10-2-26" }, "geometry": { "type": "Point", "coordinates": [ 68.136967570207489, 27.326793023227424 ] } },
{ "type": "Feature", "properties": { "field_1": 22, "Plate": "077-007-X", "Block": 7, "House": 9, "Room": "30", "Level_ft": -11.6, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with neither slip nor traces of colouring. Very careful work as if made in a mould and trimmed up afterwards. Possiblyy a dove. Of the three holes in the base, two evidently took the stick legs and the third a support to be fixted in a pedestal. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-007-x.png", "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-30" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 24, "Plate": "077-009-X", "Block": 9, "House": 9, "Room": "66", "Level_ft": -10.8, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Faience, with traces of apple-green glaze. Eyes and nostrils indicated by small pittings and the mouth by a cut. Perforated longtitudinlly, and obviously intended to be worn on a cord as an amulet. Very roughly finsihed. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-009-x.png", "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-66" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 25, "Plate": "058-004-X", "Block": 4, "House": 0, "Room": null, "Level_ft": -11.7, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/058-004-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 29, "Plate": "077-014-X", "Block": 7, "House": 4, "Room": "19", "Level_ft": -11.5, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a red wash. Heas with the long, spiral, laterla horns of a goat, an animal which seems to have been sacred among the Indus Valley people. It seems to have been supported on a stick, for which there is a rough hole. No details other than round eyes and quite indefinite ears are to be seen. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-014-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-19" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 30, "Plate": "077-015-X", "Block": 9, "House": 4, "Room": "6", "Level_ft": -6.8, "Time_Cat": "Late II", "Feature": "Animals", "Type": "Model animal", "Text": "Bronze(?) Figure of a eam in couchant position. Though carefully made, corrosion has removed much of the detail. A small pit on the shoulders suggests that it was intended to drill a hole to take a cord.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-015-x.png", "x": 68.136960165735644, "y": 27.326984249612284, "j_id": "9-4-6" }, "geometry": { "type": "Point", "coordinates": [ 68.136960165735644, 27.326984249612284 ] } },
{ "type": "Feature", "properties": { "field_1": 32, "Plate": "077-017-X", "Block": 9, "House": 0, "Room": "90", "Level_ft": -8.2, "Time_Cat": "Late III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery. Small dog with a curled tail and lop ears. Nostrils and mouth not indicated, but the eyes are represented by round pellets. Roughly modelled, possibly a child. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-017-x.png", "x": 68.137133310054224, "y": 27.326970543563384, "j_id": "9-0-90" }, "geometry": { "type": "Point", "coordinates": [ 68.137133310054224, 27.326970543563384 ] } },
{ "type": "Feature", "properties": { "field_1": 33, "Plate": "077-018-X", "Block": 9, "House": 3, "Room": "29", "Level_ft": -1.9, "Time_Cat": "Late Ia", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, formerly covered with a red wash. A curious, dog-like beast with broad erect ears and a very definite beard roughly incised to represent the separate hairs. Both ears adn nostrils are further elaborated by holes. The pellet eyes are now missing, and so is the rial. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-018-x.png", "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 34, "Plate": "077-019-X", "Block": 9, "House": 9, "Room": "65", "Level_ft": -11.5, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Faience, with no trace of glaze left. Soft white paste resembling powdered wteatite. Dog with long pricked ears, and the eyes, nostrils and mouth represented by indentations. Badly weathered, with portion missing. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-019-x.png", "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-65" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 35, "Plate": "077-020-X", "Block": 9, "House": 1, "Room": "47", "Level_ft": -3.4, "Time_Cat": "Late Ib", "Feature": "Animals", "Type": "Model animal", "Text": "Squirrel. Vitreous paste, turquoise-blue in colour. The three strips down the back are indicated by a purplish-brown, doubless a mananese paint. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-020-x.png", "x": 68.137252775657217, "y": 27.327018499916552, "j_id": "9-1-47" }, "geometry": { "type": "Point", "coordinates": [ 68.137252775657217, 27.327018499916552 ] } },
{ "type": "Feature", "properties": { "field_1": 37, "Plate": "058-012-X", "Block": 10, "House": 4, "Room": "87", "Level_ft": -11.7, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/058-012-x.png", "x": 68.136571946160444, "y": 27.326689861162478, "j_id": "10-4-87" }, "geometry": { "type": "Point", "coordinates": [ 68.136571946160444, 27.326689861162478 ] } },
{ "type": "Feature", "properties": { "field_1": 38, "Plate": "078-001-X", "Block": 9, "House": 7, "Room": "17", "Level_ft": -9.1, "Time_Cat": "Late III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Roughly modelled bull. Both horns missing. Plain, round pellets for eyes. No markings of any desciption; apparently the work of a child. Both the fore and hind-legs are joined; no attempt was made to separate them even by a line-but for this the modeling of this anumal is fairly good. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/078-001-x.png", "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-17" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 39, "Plate": "078-002-X", "Block": 9, "House": 8, "Room": "20", "Level_ft": -10.2, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Faience, with traces of a dark red(?) glaze. Soft, white paste, possibly powdered steatite. Head of a monkey with incised holes to represent eyes, ears and nostrils, and a narrow silt for the mouth. The parting of the hair on the top of the head is carefully indicated. Quite creditable workmanship. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/078-002-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-20" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 45, "Plate": "078-008-X", "Block": 4, "House": 0, "Room": "14", "Level_ft": -8.2, "Time_Cat": "Late III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a light red slip. This is possibly a monkey climbing a tree. The eyes are represented by round pellets, the nostrils and mouth by a slight incisions. Though the tail is missing, its stumps suggests that it ws held close to the legs. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-14" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 46, "Plate": "078-009-X", "Block": 9, "House": 12, "Room": "90", "Level_ft": -6.9, "Time_Cat": "Late II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with traces of a light red slip. Roughly made and finished.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/078-009-x.png", "x": 68.137254080694547, "y": 27.327143212101898, "j_id": "9-12-90" }, "geometry": { "type": "Point", "coordinates": [ 68.137254080694547, 27.327143212101898 ] } },
{ "type": "Feature", "properties": { "field_1": 47, "Plate": "078-010-X", "Block": 7, "House": 3, "Room": "40", "Level_ft": -3.2, "Time_Cat": "Late Ib", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a light red slip. This figure should have been included with the human figurines as it represents a crawling child. The pellet eyes are slightly oval, and the mouth and lips are represented as in other human figurines by incising a line on a narrow added strip of clay. Each of the slightly projecting ears has a ear-hole. The head is covered with a number of small circular disks, obviously intended to represent an infant's curls. There was also a necklace, but all that remains is a medallion still sticking to the breast, with two crossed lines incised upon it. A bangle is shown on the rihgt arm The buttocks are clearly indicated, and also the anus and sexual organs. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/078-010-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-40" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 49, "Plate": "078-012-X", "Block": 7, "House": 7, "Room": "58", "Level_ft": -10.6, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with traces of light red slip. Though there is a flat base ipon which the figure will not stand, a hole in it shows that it was intended, rather, to be supported on a stick. A hole which perhaps represents the navel communicates with the hollow interior of the figure. Roughly modelled and finished. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/078-012-x.png", "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-58" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 51, "Plate": "079-002-X", "Block": 7, "House": 8, "Room": "16", "Level_ft": -26.5, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Small figure of rhinoceros very carefully made, even to the addition of the sexual organs. Horn missing. In place of the usual strips of clay to represent the armour-like hide of the animal, the body and even parts of the head are pricked all over, a somewhat curious procedure since the rhinoceros is comparatively hairless. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-002-x.png", "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 52, "Plate": "108-014-X", "Block": 4, "House": 0, "Room": "5", "Level_ft": -18.4, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Peg", "Text": "Part of the horn of a deer or antelope with a groove cut round it near the broader end. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-5" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 55, "Plate": "079-006-X", "Block": 9, "House": 2, "Room": "9", "Level_ft": -12.2, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Bronze. Dog with collar round neck. Prick ears and upright tail. Short mastiff-like muzzle. Fore- and hid-legs cast together; but it may have been intended to separate them later by cutting. Well made, but very much corroded. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-006-x.png", "x": 68.1370390412213, "y": 27.327004308790809, "j_id": "9-2-9" }, "geometry": { "type": "Point", "coordinates": [ 68.1370390412213, 27.327004308790809 ] } },
{ "type": "Feature", "properties": { "field_1": 56, "Plate": "109-060-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -17.7, "Time_Cat": "Intermediate III", "Feature": "Games And Toys", "Type": "Whistle", "Text": "Very hard baked pottery; no slip. A somewhat roughly made, pear-shaped object with a small hole at the top and another in the side. Three of these whistles, all slightly different in size, were found together. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 57, "Plate": "079-008-X", "Block": 9, "House": 8, "Room": "18", "Level_ft": -14.3, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. A hollow, round bodied anumal similar to No, 7 but with the ears practically perfect. The tail hangs, instead of being upright. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-008-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 60, "Plate": "079-011-X", "Block": 9, "House": 3, "Room": "35", "Level_ft": -15.8, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; with a cream slip. Solid. Dog with heavy collar round neck. Short prick ears; apparently upright tail, now broken. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-011-x.png", "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-35" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 61, "Plate": "109-061-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -17.7, "Time_Cat": "Intermediate III", "Feature": "Games And Toys", "Type": "Whistle", "Text": "Very hard baked pottery; no slip. A somewhat roughly made, pear-shaped object with a small hole at the top and another in the side. Three of these whistles, all slightly different in size, were found together. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 62, "Plate": "136-094-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -18.4, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Bracelet (stoneware)", "Text": "Fragment. Dark grey throughout.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 64, "Plate": "079-015-X", "Block": 7, "House": 1, "Room": "3", "Level_ft": -33.3, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Dog with short upright tail, and a very heavy collar. The ears, unfortunately, are broken, but they were eidently pricked. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-015-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-3" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 65, "Plate": "079-016-X", "Block": 7, "House": 9, "Room": "29", "Level_ft": -26.9, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Humped bull, with fore- and hind-legs joined. A little incised work round the head. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-016-x.png", "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 66, "Plate": "080-022-X", "Block": 7, "House": 1, "Room": "3", "Level_ft": -14.9, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Though the head of this bird is missing, the graceful carve of the neck and body, and the long broad tail and stout legs identify it with the peacock. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-022-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-3" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 67, "Plate": "079-018-X", "Block": 10, "House": 3, "Room": null, "Level_ft": -14.8, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Bronze. No. 20 is an enlarged illustration of this well modelled animal which, as far as can be judges, is a solid casting. That it represents a bull and not a bison is indicated by the carriage of the head. Rather roughly made; but probably it was intended to trim it up afterwards, which seems never to have been done, though corrosion may have removed the finer details. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-018-x.png", "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 69, "Plate": "079-020-X", "Block": 10, "House": 3, "Room": null, "Level_ft": -14.8, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "see No.18 above. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-020-x.png", "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 70, "Plate": "109-051-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -18.3, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Spindle-whorls(?)", "Text": null, "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 73, "Plate": "079-024-X", "Block": 7, "House": 2, "Room": "93", "Level_ft": -21.4, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Steatite. Well-carved model of a bull, whose separately made horns and ears were fixed in sockets and may have been of another material. Other sockets served for the attachment of the sexual organs, and the tail which lay in a groove between the buttocks. A larger hole between the legs suggests that this figure was supported on a stand. The wrinkles and hair on head and neck, and the garland round the latter had been carefully owrked with a graver. The eyes may not have been inlaid as the sockets are very shallow. The figurine seems not to have been glazed, but merely coated with a white slip like that on teh seals. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-024-x.png", "x": 68.137268560324117, "y": 27.32683601680181, "j_id": "7-2-93" }, "geometry": { "type": "Point", "coordinates": [ 68.137268560324117, 27.32683601680181 ] } },
{ "type": "Feature", "properties": { "field_1": 75, "Plate": "079-026-X", "Block": 7, "House": 9, "Room": "29", "Level_ft": -32.7, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Carefully made model of a humped bull with inset eyes and united fore- and hind legs. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-026-x.png", "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 76, "Plate": "075-014-X", "Block": 7, "House": 1, "Room": "3", "Level_ft": -29.9, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. Torso of a woman clasping a baby to her breast which is hidden by a number of necklaces that are arranged in double rows-possibly to represent double strings of beads.- and have their ends brought to the front. These necklaces though apparently continued round the back of the figure are not so in reality. Roughly fashioned, especially the figure of the infant. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-014-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-3" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 79, "Plate": "079-030-X", "Block": 7, "House": 8, "Room": "16", "Level_ft": -24.1, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; cream slip. Hollow model of a bull of very careful workmanship. Fashioned entirely by hand and with great stress laid on the various details which were cut with a graver before baking. Round the neck there is a twisted double bank, which may represent a garland of flowers or , more likely, a plaited rope. The horns and ears are unfortunately missing. The eyes are small round pellets inserted in cuts made in the caly before baking. A small hole beneath is probably only a vent for the escape of air during baking", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-030-x.png", "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 84, "Plate": "100-013-X", "Block": 4, "House": 0, "Room": "15", "Level_ft": -18.3, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Pin-head ", "Text": "Steatite, with no trace of glaze, carved to represent two monkeys embracing one another, somewhat in the manner of another pin-head in the same material found in a previous season. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-15" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 85, "Plate": "061-019-X", "Block": 4, "House": 0, "Room": null, "Level_ft": -12.0, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/061-019-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 94, "Plate": "109-008-X", "Block": 4, "House": 0, "Room": null, "Level_ft": -19.8, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Awl", "Text": "Bone. One end is missing. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 98, "Plate": "109-058-X", "Block": 7, "House": 1, "Room": "3", "Level_ft": -33.3, "Time_Cat": "Early Periods", "Feature": "Tools", "Type": "Spindle-whorls(?)", "Text": "Both top and base slightly concave. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-3" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 100, "Plate": "081-008-X", "Block": 9, "House": 7, "Room": "17", "Level_ft": -14.4, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; red slip. A very similar animal to no. 14, but with a protruding adbomen and a large flat tial, whose tip is missing. Similar figures to these have been found in the later levels.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-008-x.png", "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-17" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 102, "Plate": "100-011-X", "Block": 7, "House": 1, "Room": "5", "Level_ft": -16.9, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Ivory. Greater part of pin missing. Incised lines decorate the head for which see the line drawing and appear once to have been filled in with black. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-5" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 104, "Plate": "109-038-X", "Block": 7, "House": 1, "Room": "9", "Level_ft": -24.4, "Time_Cat": "Early Periods", "Feature": "Tools", "Type": "Whestones", "Text": "Dark grey slate. The business end of this short hone is rounded.", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-9" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 106, "Plate": "080-024-X", "Block": 7, "House": 4, "Room": "49", "Level_ft": -15.1, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Cream-coloured paste. Height of head only. Model head of a crested bird. No trace of glaze now remains, but brown stains here and there on the paste suggest that the glaze was originally green. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-024-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-49" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 108, "Plate": "080-020-X", "Block": 7, "House": 3, "Room": "40", "Level_ft": -17.0, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with ared slip. An amusing model fowl with a food dish in front of it. Though the head is missing, the tail is certainly that of a domestic fowl. The food-vessel is not unlike a type of vessel that is very common at Mohenjo-daro. Both bird and dish are fixed on a thin rectangular stand. This model is especially valuable, in that it it furnishes a proof that the fowl was domesticated at Mohenjo-daro; which after all is not surpisring, since the domestic fowl, now bred all over the world, is supposed to have orifinated in India. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-020-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-40" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 113, "Plate": "081-003-X", "Block": 4, "House": 0, "Room": "79", "Level_ft": -21.3, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Probably a bird's head on a neck which terminates below in a rounded base. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-003-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-79" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 114, "Plate": "081-004-X", "Block": 10, "House": 1, "Room": "6", "Level_ft": -29.7, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Bird's head on a long neck which is flanged about half-way down. The projection below the flange has a hole pierced through it to take a string. Round pellet eyes. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-004-x.png", "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-6" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 115, "Plate": "079-013-X", "Block": 7, "House": 3, "Room": "44", "Level_ft": -16.6, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a red wash. Hollow model of elephant; roughly fashioned but shows the charateristic spinal ridge. Models of this animal in clay are rare, and this is the first that we have found with the trunk intact. The figure was modelled with considerable fedelity; and though the eyes are over large, they are in the right position and appear very lifelike. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-013-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-44" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 118, "Plate": "081-017-X", "Block": 9, "House": 8, "Room": "18", "Level_ft": -14.6, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Similar figure to no. 13, but not so flat and better made. The holes for the axle are 0.29\" in diameter, and a smaller hole for a cord passes through the neck. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-017-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 119, "Plate": "081-018-X", "Block": 9, "House": 2, "Room": "11", "Level_ft": -13.1, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, no slip. This may possibly represent a monkey, through the ears are over large. It seems to be perched on a board mounted on a pole. If this be so, it is possible that pet animals, whether monkeys or other creatures, were fastened to stands on which they lived with sufficient length of chain to allow of their visiting the ground. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-018-x.png", "x": 68.1370390412213, "y": 27.327004308790809, "j_id": "9-2-11" }, "geometry": { "type": "Point", "coordinates": [ 68.1370390412213, 27.327004308790809 ] } },
{ "type": "Feature", "properties": { "field_1": 122, "Plate": "081-012-X", "Block": 7, "House": 3, "Room": "48", "Level_ft": -14.8, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. This little object appears to be a gamesman, as it has a flat base on which to stand. The eyes and nose are the only features indicated. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-012-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-48" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 123, "Plate": "111-091-X", "Block": 7, "House": 3, "Room": "44", "Level_ft": -18.3, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Shell-ladles", "Text": "Seems to have been discarded unfinished owing to a fracture in the shell. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-44" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 127, "Plate": "105-021-X", "Block": 9, "House": 10, "Room": "86", "Level_ft": -7.8, "Time_Cat": "Late III", "Feature": "Cooking Baking Utensils", "Type": "Shell-ladles", "Text": "Well finished, with some slight evidence here and there of polish.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-86" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 128, "Plate": "105-026-X", "Block": 9, "House": 6, "Room": "36", "Level_ft": -5.6, "Time_Cat": "Late II", "Feature": "Cooking Baking Utensils", "Type": "Shell-ladles", "Text": "Well made and finished but somewhat weathered. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-36" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 129, "Plate": "081-019-X", "Block": 7, "House": 3, "Room": "44", "Level_ft": -12.3, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with traces of a red slip. Very roughly modelled monkey(?), climbing a pole or tree which was formerly affixed upon a stand. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-019-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-44" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 130, "Plate": "081-035-X", "Block": 7, "House": 8, "Room": "20", "Level_ft": -13.4, "Time_Cat": "Intermediate II", "Feature": "Animals", "Type": "Model animal", "Text": "Made of Alabaster. The point of this horn is missing and in the middle of the square cut, broad end there is a hole. There can be no doubt, I think, that this object was one of the horns of a large statue of a bull; horns were frequently fitted on models of bulls of even small size. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-20" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 132, "Plate": "112-010-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -36.6, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. A humpless bull with round, inlaid pellets to represent theeyes. Horns and three of the legs are missing. Wrinkles round neck and back incised with a sharp pointed instrument. Apparently solid, and somewhat roughly made. Traces of fine mica and lime in the clay, the lime in particles of appreciable size. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 133, "Plate": "112-011-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -42.1, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Humped bull with round, inlaid pellets for eyes. Horns missing. Fore- and hind-legs joined in pairs; slightly damaged. Wrinkles on hump and lower part of head incised with a pointed instrumetn. Fine red clay tempered with mica and lime. Solid and not particularly carefully made. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 134, "Plate": "105-009-X", "Block": 9, "House": 1, "Room": "47", "Level_ft": -4.3, "Time_Cat": "Late Ib", "Feature": "Cooking Baking Utensils", "Type": "Shell Dish", "Text": "Dish-like shell vessel, was cut from abother species of shell. This dish was carefully rubbed down but not polished. This dish well made though somewaht irregular in shape, was carefully rubbed down but not polished. Several places were perforated by well drilled holes. These holes may have been plugged with fillings that have dopped out or decayed in the course of time. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137252775657217, "y": 27.327018499916552, "j_id": "9-1-47" }, "geometry": { "type": "Point", "coordinates": [ 68.137252775657217, 27.327018499916552 ] } },
{ "type": "Feature", "properties": { "field_1": 135, "Plate": "104-019-X", "Block": 9, "House": 1, "Room": "48", "Level_ft": -11.1, "Time_Cat": "Intermediate I", "Feature": "Cooking Baking Utensils", "Type": "Gutter ", "Text": "Light red pottery; no slip. Two well made gutters, with taspering channels. Four slight cuts across one side of one of these gutters evidently served for identification. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137252775657217, "y": 27.327018499916552, "j_id": "9-1-48" }, "geometry": { "type": "Point", "coordinates": [ 68.137252775657217, 27.327018499916552 ] } },
{ "type": "Feature", "properties": { "field_1": 138, "Plate": "079-012-X", "Block": 7, "House": 3, "Room": "46", "Level_ft": -16.7, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Spirited figure of dog wearing a stout collar. Short upright tail and broad prick ears. Nostrils and anus indicated, but no other organs. Very rough workmanship. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-012-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-46" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 139, "Plate": "080-026-X", "Block": 7, "House": 3, "Room": "46", "Level_ft": -16.5, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Drab-coloured pottery. Model of a singing bird; carefully made, but now somewhat discoloured by smoke. It seems likely in view of this model that song-birds were kept in captivity, and it is unfortunate that we have only the head and part of the body, so that it is impossible to identify it. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-026-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-46" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 142, "Plate": "108-029-X", "Block": 9, "House": 6, "Room": "79", "Level_ft": -20.4, "Time_Cat": "[check data]", "Feature": "Cooking Baking Utensils", "Type": "Gutter", "Text": "Pottery. Somewhawt roughly made, but none teh less efficient.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-79" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 143, "Plate": "104-011-X", "Block": 9, "House": 6, "Room": "79", "Level_ft": -8.4, "Time_Cat": "Late III", "Feature": "Cooking Baking Utensils", "Type": "Triangular Plaque", "Text": "Drab-coloured pottery; no slip. Roughly made and indifferently baked. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-79" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 144, "Plate": "142-007-X", "Block": 7, "House": 3, "Room": "51", "Level_ft": -16.2, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Bracelet (stoneware)", "Text": "Fragment. Dark grey throughout.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-51" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 149, "Plate": "109-041-X", "Block": 7, "House": 3, "Room": "51", "Level_ft": -17.3, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Stone Cone", "Text": "Dark grey slate; unpolished but smoothly finished. With its bevelled base this resembles some of the pottery cones. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-51" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 150, "Plate": "109-002-X", "Block": 7, "House": 9, "Room": "29", "Level_ft": -21.0, "Time_Cat": "Early Periods", "Feature": "Cooking Baking Utensils", "Type": "Cake-mould", "Text": "Pottery; light red in colour with a thick, cream slip. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 152, "Plate": "105-042-X", "Block": 9, "House": 9, "Room": null, "Level_ft": -1.0, "Time_Cat": "Late Ia", "Feature": "Cooking Baking Utensils", "Type": "Shell Ornament", "Text": "Shell. It is possible that these lines were once with a slightly irregular, natural hole, in which, perhaps, a metal staple and ring were fitted to lift the cover made from this object and its fellow. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 153, "Plate": "109-021-X", "Block": 7, "House": 4, "Room": "49", "Level_ft": -20.0, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Pottery Cone", "Text": "Very hard baked pottery, pink pottery. Made on a wheel. Point missing. Spiral line of incised dots on the lower portion. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-49" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 155, "Plate": "104-006-X", "Block": 9, "House": 6, "Room": "79", "Level_ft": -6.7, "Time_Cat": "Late II", "Feature": "Cooking Baking Utensils", "Type": "Pottery of unkown use", "Text": "Well baked, pink pottery, containing mica and lime; no slip. The ring, carefully made by hand and showing no sign of wear, was slightly wraped in baking.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-79" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 158, "Plate": "108-018-X", "Block": 7, "House": 4, "Room": "50", "Level_ft": -19.3, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Gutter", "Text": "Brick. Possibly a number of these bricks were placed end to end to form a horizontal drain. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-50" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 160, "Plate": "108-007-X", "Block": 10, "House": 0, "Room": null, "Level_ft": -23.4, "Time_Cat": "Early Periods", "Feature": "Cooking Baking Utensils", "Type": "Door-socket", "Text": "Is a half-brick in whcih a cavity shows much wear. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136818531950922, "y": 27.326713129436506, "j_id": "10-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.136818531950922, 27.326713129436506 ] } },
{ "type": "Feature", "properties": { "field_1": 162, "Plate": "104-015-X", "Block": 9, "House": 6, "Room": "32", "Level_ft": -7.2, "Time_Cat": "Late III", "Feature": "Cooking Baking Utensils", "Type": "Pottery of unkown use", "Text": "An oval plaque of soft, white alabaster, less than a third of which is missing. It has a flat- V-shaped projection. The V-shaped ridge, whehter on the top or underneath of the plaque, was probably intended to slide in a corresponding groove, though it is neither tapered nor provided with a stop. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-32" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 163, "Plate": "112-004-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -42.6, "Time_Cat": "Early Periods", "Feature": "Cooking Baking Utensils", "Type": "Triangular Plaque", "Text": "Pottery. Roughly baked. Carelessly made, and had been laid on chopped straw to dry before bakign, as shown by the imprints of the straw on one side. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 164, "Plate": "104-017-X", "Block": 9, "House": 6, "Room": "32", "Level_ft": -7.2, "Time_Cat": "Late III", "Feature": "Cooking Baking Utensils", "Type": "Pottery of unkown use", "Text": "An oval plaque of soft, white alabaster, less than a third of which is missing. It has a flat- V-shaped projection. The V-shaped ridge, whehter on the top or underneath of the plaque, was probably intended to slide in a corresponding groove, though it is neither tapered nor provided with a stop. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-32" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 168, "Plate": "061-069-X", "Block": 10, "House": 4, "Room": "84", "Level_ft": -12.5, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/061-069-x.png", "x": 68.136571946160444, "y": 27.326689861162478, "j_id": "10-4-84" }, "geometry": { "type": "Point", "coordinates": [ 68.136571946160444, 27.326689861162478 ] } },
{ "type": "Feature", "properties": { "field_1": 169, "Plate": "109-018-X", "Block": 4, "House": 0, "Room": "15", "Level_ft": -20.4, "Time_Cat": "[check data]", "Feature": "Cooking Baking Utensils", "Type": "Label", "Text": "Has a small hole in the lug for trying it on. The label is roughly made and has no slip, but the surface is sufficiently smooth for writing. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-15" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 170, "Plate": "065-005-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -12.4, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/065-005-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 172, "Plate": "105-023-X", "Block": 9, "House": 3, "Room": "34", "Level_ft": -5.2, "Time_Cat": "Late II", "Feature": "Cooking Baking Utensils", "Type": "Pottery of unkown use", "Text": "Made of pottery and possiblely used in weaving, which should not be confused with the pottery bullae illustrated elsewhere. Carefully made and coated with a cream slip.Small holes pricked in two rows at the wider end of wither face. Those of the upper row seen in the illustration completely penetrate teh object, but those of the lower row are blind. On the reverse, it is the holes of the upper row which are blind. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-34" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 177, "Plate": "109-012-X", "Block": 7, "House": 8, "Room": "22", "Level_ft": -14.2, "Time_Cat": "Intermediate II", "Feature": "Cooking Baking Utensils", "Type": "Pottery hook", "Text": "Pottery; cream slip.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-22" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 183, "Plate": "109-006-X", "Block": 7, "House": 3, "Room": "48", "Level_ft": -14.8, "Time_Cat": "Intermediate II", "Feature": "Cooking Baking Utensils", "Type": "Ivory Baton", "Text": "Well made and much polished by wear. Incised decoration beneath the head once filled in with black. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-48" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 189, "Plate": "110-054-X", "Block": 7, "House": 4, "Room": "50", "Level_ft": -17.2, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Ivory. Lower part missing. Top of head decorated with simple incised cross-hatching. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-50" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 192, "Plate": "110-055-X", "Block": 7, "House": 4, "Room": "50", "Level_ft": -17.2, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Ivory. This object may once have been longer as the end of the shank appears to be broken. Decorated on the two broader faces only with incised curved lines. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-50" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 195, "Plate": "109-031-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -13.7, "Time_Cat": "Intermediate II", "Feature": "Cooking Baking Utensils", "Type": "Tube", "Text": "Made of a carefully cleaned-out bone. The outside is polished by much use. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 197, "Plate": "100-002-X", "Block": 7, "House": 4, "Room": "71", "Level_ft": -18.2, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Ivory. fining down to a good point. Much polished by use. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-71" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 198, "Plate": "109-004-X", "Block": 9, "House": 8, "Room": "18", "Level_ft": -12.9, "Time_Cat": "Intermediate I", "Feature": "Cooking Baking Utensils", "Type": "Ivory Roundel", "Text": "The side of this roundel is cross-hatched with incised lines that were once filled in with black.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 199, "Plate": "142-079-X", "Block": 9, "House": 3, "Room": "35", "Level_ft": -14.2, "Time_Cat": "Intermediate II", "Feature": "Games And Toys", "Type": "Whistle", "Text": "Pottery; with traces of a light red slip. Apparently a miniature jar whose rim had been rubbed down to enlarge the hole slightly. A second hole near the mouth was doubtless used as a stop, as in the above example. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-35" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 200, "Plate": "140-021-X", "Block": 9, "House": 10, "Room": "85", "Level_ft": -7.0, "Time_Cat": "Late III", "Feature": "Games And Toys", "Type": "LIght grey pottery. Ornamented with parallel dark-red lines, those on one hemisphere at right angles to those on the other. ", "Text": "Average diameter 1.4\"", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-85" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 202, "Plate": "142-081-X", "Block": 9, "House": 7, "Room": "17", "Level_ft": -15.4, "Time_Cat": "Intermediate II", "Feature": "Games And Toys", "Type": "Light red pottery; no slip. Roughly decorated with red lines. Found together. ", "Text": "Light red pottery; no slip. Roughly decorated with red lines. Found with No. 80 together", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-17" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 211, "Plate": "081-005-X", "Block": 7, "House": 4, "Room": "72", "Level_ft": -18.5, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. A figure with a bird-like head that in its curious shape resembles No. 9. On either side are short raised arms or wings. Two perforated projections behind, which have been broken off, suggest that this onject was swung on a rod. A small hole through the neck probably served to take a cord. The lower part of the body is missing. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-005-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-72" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 212, "Plate": "081-013-X", "Block": 7, "House": 4, "Room": "72", "Level_ft": -16.3, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Roughly made, hollow model of a bird with expanded tail and round pellet eyes. Two holes took an axle on which a pair of pottery wheels were fixed; the top was drawn along by a cord passed through a small perforation in the base of the head. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/081-013-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-72" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 213, "Plate": "140-019-X", "Block": 9, "House": 12, "Room": "94", "Level_ft": -9.0, "Time_Cat": "Late III", "Feature": "Games And Toys", "Type": "Cubical Dice", "Text": "Reddish pottery; smoked-stained in places. Very roughly made, and badly out of shape. 1 opposite 3, 2 opposite 4, 5 opposite 6. The holes that indicate the numbers were made with a pointed stick. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137254080694547, "y": 27.327143212101898, "j_id": "9-12-94" }, "geometry": { "type": "Point", "coordinates": [ 68.137254080694547, 27.327143212101898 ] } },
{ "type": "Feature", "properties": { "field_1": 215, "Plate": "109-015-X", "Block": 7, "House": 8, "Room": "19", "Level_ft": -13.2, "Time_Cat": "Intermediate II", "Feature": "Cooking Baking Utensils", "Type": "Ivory Roundel", "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-19" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 217, "Plate": "109-025-X", "Block": 7, "House": 5, "Room": "68", "Level_ft": -17.2, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Pottery of unkown use", "Text": "Pierced rectangular plaque. Appears to be pottery. Well made. In its centre a rectangular hole pierces it vertically. Four small, round holes. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-68" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 225, "Plate": "108-016-X", "Block": 7, "House": 6, "Room": "66", "Level_ft": -18.7, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Brick", "Text": "With a deep lunate excision on one side of it. The cutting which is slightly oblique was very roughly done. The elaborate head-gear worn by some of the female figurines, which head-dress may also have been that of the commona people, would certainly have neccessitated the use of some kind of head-rest at night; but the majority of these would probably have been made of wood and have perished. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137454723356953, "y": 27.326652368157955, "j_id": "7-6-66" }, "geometry": { "type": "Point", "coordinates": [ 68.137454723356953, 27.326652368157955 ] } },
{ "type": "Feature", "properties": { "field_1": 226, "Plate": "080-012-X", "Block": 7, "House": 7, "Room": "20", "Level_ft": -19.7, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Model ram, with the curly fleece roughly indicated by curved lines. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-012-x.png", "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-20" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 227, "Plate": "140-028-X", "Block": 9, "House": 6, "Room": "30", "Level_ft": -5.5, "Time_Cat": "Late II", "Feature": "Games And Toys", "Type": "Ball", "Text": "White crystal. Well made and carefully polished. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-30" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 228, "Plate": "112-003-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -41.0, "Time_Cat": "Early Periods", "Feature": "Games And Toys", "Type": "Light red pottery. The lines that decorate this rattle are now light grey, perhaps owing to a long immersion in water having latered the original red.  ", "Text": "Average diameter 2.3\" ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 229, "Plate": "142-066-X", "Block": 9, "House": 5, "Room": null, "Level_ft": -14.6, "Time_Cat": "Intermediate II", "Feature": "Games And Toys", "Type": "Ball", "Text": "Alabaster. Somewhat out of shape through the action of water. Ornamented with incised, concentric circles, regularly arranged like those on the shell balls. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136825970318398, "y": 27.327015864059192, "j_id": "9-5-" }, "geometry": { "type": "Point", "coordinates": [ 68.136825970318398, 27.327015864059192 ] } },
{ "type": "Feature", "properties": { "field_1": 231, "Plate": "072-002-X", "Block": 9, "House": 7, "Room": "17", "Level_ft": -10.5, "Time_Cat": "Intermediate I", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; with a red slip. This roughly modelled figure represents a very matronly woman nursing an infant at her right breast. The figure of the infant has, however, almost entirely gone and only a portion of the legs remains. The mother had originally two footless pointed legs like the one seen in the photo, but as they could not possibly support her properly, a pedestal was placed behind them, with the help of which despite its being broken the figure still stands upright. The head is very roughly modelled, a mere pinch sufficing to form the nose; and the usual round pellets serve as eyes, though an indentation in the centre of each to represent the pupil is very unusual feature. Possibly this was a votive figure intended to be placed in a shrine, either for the purpose of obtaining offspring or in thanks for the arrival of one. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-002-x.png", "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-17" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 232, "Plate": "142-087-X", "Block": 4, "House": 0, "Room": "13", "Level_ft": -13.7, "Time_Cat": "Intermediate II", "Feature": "Games And Toys", "Type": "Light red pottery. Decorated with red lines. ", "Text": "Light red pottery. Decorated with red lines.  ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-13" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 233, "Plate": "142-088-X", "Block": 7, "House": 8, "Room": "16", "Level_ft": -26.2, "Time_Cat": "Early Periods", "Feature": "Games And Toys", "Type": "Drab coloured pottery. More carefully made than usual, and more or less decorated with crossed, dark red lines. ", "Text": "Drab coloured pottery. Mre carefully made than crossed, dark red lines. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 235, "Plate": "072-003-X", "Block": 9, "House": 10, "Room": "81", "Level_ft": -6.7, "Time_Cat": "Late II", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, once with a red slip. This very roughly fashioned figure is of interest because the left leg, part of which unfortunately missing, was raised to suggest either walking or dancing. The head is flat and the eyes are represented by two slightly elongated discs. There is no nose to speak of, and no attempt at a mouth. The arms are merely added strips of clay, and the figure is not carrying something under the arm as appears at first sight. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-003-x.png", "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-81" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 239, "Plate": "142-085-X", "Block": 7, "House": 9, "Room": "29", "Level_ft": -13.2, "Time_Cat": "Intermediate II", "Feature": "Games And Toys", "Type": "Cubical Dice", "Text": "Accurately made with the angles slightly rounded. The holes that indicate the numbers are carefully drilled.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 242, "Plate": "110-048-X", "Block": 4, "House": 0, "Room": "14", "Level_ft": -20.2, "Time_Cat": "Intermediate III", "Feature": "Games And Toys", "Type": "Round Rod", "Text": "Ivory. Small group of pictographs on one side. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-14" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 245, "Plate": "065-006-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -12.4, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/065-006-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 254, "Plate": "141-038-X", "Block": 7, "House": 9, "Room": "33", "Level_ft": -9.1, "Time_Cat": "Late III", "Feature": "Games And Toys", "Type": "Miscellaneous Ivory Object", "Text": "Ivory. A shallow hole in each end. Entirely undecorated. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-33" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 255, "Plate": "141-047-X", "Block": 4, "House": 0, "Room": "79", "Level_ft": -5.9, "Time_Cat": "Late II", "Feature": "Games And Toys", "Type": "Miscellaneous Ivory Object", "Text": "Ivory. Polished by wear. The edges are marked with concetric circles in three places, and the front and back are ornamented as illustrated. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-79" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 259, "Plate": "142-071-X", "Block": 7, "House": 7, "Room": "57", "Level_ft": -16.5, "Time_Cat": "Intermediate III", "Feature": "Games And Toys", "Type": "Ball", "Text": "White limestone. Drilled irrefularly all over with shallow pittings which probably once held a coloured paste. A hole in this object may have been intended to take a pin; if sp, this ball should be classed with the pin-head. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-57" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 265, "Plate": "072-008-X", "Block": 9, "House": 3, "Room": "30", "Level_ft": -4.9, "Time_Cat": "Late Ib", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, coated liberally with a red wash. This male figure is complete, except for the feet and a small portion of the beard. It is very carefully modelled, save the hands which are merely flattened extrmeities. The oval eyes were set with a slight slant upwards towards the bridge of the nose. The mouth is indicated in the usual way and a very prominent, broad, projecting beard is a distinguishing feature. The hair is represented as a broad flat mass drawn from the forehead in a loop with end secured by a fillet, which when the figure was complete passed across the forehead. Part of the genital organs is missing. The figurine is covered in many places with black patchy deposits which are, however, of too coarse a nature to have been another slip applied over the red wash. Possibly the figure was anointed on a ceremonial occasions with butter which are carbonized. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-008-x.png", "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-30" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 266, "Plate": "140-036-X", "Block": 7, "House": 3, "Room": "41", "Level_ft": -4.2, "Time_Cat": "Late Ib", "Feature": "Games And Toys", "Type": "Ball", "Text": "White limestone. Well made, smooth, but unpolished surface. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-41" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 267, "Plate": "072-009-X", "Block": 9, "House": 3, "Room": "30", "Level_ft": -4.9, "Time_Cat": "Late Ib", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with no signs of slip. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-009-x.png", "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-30" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 268, "Plate": "139-004-X", "Block": 7, "House": 7, "Room": "57", "Level_ft": -16.5, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "White steatite. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-57" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 274, "Plate": "112-005-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -41.0, "Time_Cat": "Early Periods", "Feature": "Games And Toys", "Type": "Wheel", "Text": "Pottery; containing a plentiful admixture of coarse lime particles.Hole in centre, shows a certain amount of wear. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 279, "Plate": "109-045-X", "Block": 10, "House": 1, "Room": null, "Level_ft": -31.0, "Time_Cat": "Early Periods", "Feature": "Household Objects", "Type": "Stone Rubber", "Text": "Material: a hard, white, crystalline stone. Upper surface rounded; base flat. This stone which is evidently a rubber may have been used in preparing skins.", "N1": "Artefacts", "Class": "Other", "photo": null, "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 280, "Plate": "139-071-X", "Block": 7, "House": 7, "Room": "57", "Level_ft": -16.5, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "White limestone. Spherical. Shallow pittings irregularly drilled all over surface, doubtless to take a coloured paste.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-57" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 284, "Plate": "066-012-X", "Block": 10, "House": 1, "Room": "2", "Level_ft": -12.0, "Time_Cat": "Intermediate I", "Feature": "Pottery - Plain and Banded", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/066-012-x.png", "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-2" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 287, "Plate": "072-001-X", "Block": 4, "House": 0, "Room": "10", "Level_ft": -8.0, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. The prominent nose was made by pinching up the front of the pellet-like head so as to form a slight hollow on each side, in which the eyes made of circular flat pellets were placed. The mouth is a mere cut. The back of the head to the right side of the head so that the end can just be seen in the illustration. The breasts are represented by pellets of clay. The arms and the rest of the body below the waist are missing. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-001-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-10" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 288, "Plate": "072-010-X", "Block": 9, "House": 3, "Room": "30", "Level_ft": -4.9, "Time_Cat": "Late Ib", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with no signs of slip. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-010-x.png", "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-30" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 289, "Plate": "073-005-X", "Block": 9, "House": 2, "Room": "8", "Level_ft": -4.3, "Time_Cat": "Late Ib", "Feature": "Human Figure", "Type": "Figurine", "Text": "Bronze. A beautifully modelled foot which may have belonged to a statue similar to the one seen in No.9, 11. The curiously shaped anklet is a pattern is made of silver. The ankle is if anything a little too slender for the size of the foot, but this may have been a convention, for the limbs of both the bronze statues are remarkably thin and attenuated. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-005-x.png", "x": 68.1370390412213, "y": 27.327004308790809, "j_id": "9-2-8" }, "geometry": { "type": "Point", "coordinates": [ 68.1370390412213, 27.327004308790809 ] } },
{ "type": "Feature", "properties": { "field_1": 293, "Plate": "069-015-X", "Block": 10, "House": 3, "Room": "4", "Level_ft": -10.7, "Time_Cat": "Intermediate I", "Feature": "Pottery - Incised and Painted", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Other", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/069-015-x.png", "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-4" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 294, "Plate": "073-009-X", "Block": 9, "House": 10, "Room": "81", "Level_ft": -8.6, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Bronze. An exceptionally well-modelled figure of a dancing girl which, unfortunately, has suffered badly from corrosion. The figure now published stands with the feet close together and left arm, which is heavily loaded with bracelets, has the hand on the hip. The right arm is brought in front of the body with the hand curved slightly upwards as if to hold something. The hair appears to have been tied at the back of the head with a part hanging down, but the details are obscured by corrosion. There is a very distinct bow, however, at the nape of the neck. There are no indications of anklets being worn. A tang below the feet served to afflix this little figure to a stand. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-009-x.png", "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-81" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 295, "Plate": "073-010-X", "Block": 9, "House": 10, "Room": "81", "Level_ft": -8.6, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Bronze. An exceptionally well-modelled figure of a dancing girl which, unfortunately, has suffered badly from corrosion. The figure now published stands with the feet close together and left arm, which is heavily loaded with bracelets, has the hand on the hip. The right arm is brought in front of the body with the hand curved slightly upwards as if to hold something. The hair appears to have been tied at the back of the head with a part hanging down, but the details are obscured by corrosion. There is a very distinct bow, however, at the nape of the neck. There are no indications of anklets being worn. A tang below the feet served to afflix this little figure to a stand. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-010-x.png", "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-81" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 296, "Plate": "073-011-X", "Block": 9, "House": 10, "Room": "81", "Level_ft": -8.6, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Bronze. An exceptionally well-modelled figure of a dancing girl which, unfortunately, has suffered badly from corrosion. The figure now published stands with the feet close together and left arm, which is heavily loaded with bracelets, has the hand on the hip. The right arm is brought in front of the body with the hand curved slightly upwards as if to hold something. The hair appears to have been tied at the back of the head with a part hanging down, but the details are obscured by corrosion. There is a very distinct bow, however, at the nape of the neck. There are no indications of anklets being worn. A tang below the feet served to afflix this little figure to a stand. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-011-x.png", "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-81" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 299, "Plate": "073-003-X", "Block": 10, "House": 3, "Room": "64", "Level_ft": -9.7, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a light red wash. Fanshaped portion of head-dress badly damaged, but the well-preserved panniers have  soot-like martks inside. A medallion above the forehead holds the bands supporting the panniers in place and apparently there was once another medallion attached in front of the pannier above the left car. Traces of white plaster still remain in the interstices of the ornamentation. The oval eye-pellets are horizontally set and the mouth carefully shaped. There are the usual tight necklaces, but nothing remains below them.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-003-x.png", "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-64" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 300, "Plate": "073-004-X", "Block": 7, "House": 2, "Room": "89", "Level_ft": -7.3, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with traces of a dark red slip or wash. On the head of this female figurine there are patches of a white concretion which looks like the remains of a stucco covering. If it were thus originally plastered, it would be like No. 3 above. This white coating now only remains around the face, and the stucco may have been quite local. The eyes are very elongated and horizontally set, the nose very prominently pinched up. The mouth is indicated in the usual way by indenting a strip of clay to form the lips. The fan-shaped portion of the head-dress is more than usually upstanding, and the pannier-like objects on each side of the head are partly hidden from the front view by various supporting bands which were ornamented by pellets of clay, intended perhaps to represent medallions. The ends of two of these strips are brought so far forward on each side of the face as partially to obscure the features. The interiors of both panniers are stained black. This is somewhat roughly made figurine, though evidently the work of experienced hands. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-004-x.png", "x": 68.137268560324117, "y": 27.32683601680181, "j_id": "7-2-89" }, "geometry": { "type": "Point", "coordinates": [ 68.137268560324117, 27.32683601680181 ] } },
{ "type": "Feature", "properties": { "field_1": 301, "Plate": "074-022-X", "Block": 9, "House": 8, "Room": "18", "Level_ft": -13.4, "Time_Cat": "Intermediate II", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. A mask with hollow back, made in a mould and roughly finished behind. The horns seem to be those of a bison, and ears are roughly indicated below them by the addition of strips of clay. Two holes for attachment. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/074-022-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 304, "Plate": "073-008-X", "Block": 7, "House": 4, "Room": "70", "Level_ft": -11.4, "Time_Cat": "Intermediate I", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a dark red slip. Oval eye-pellets and the mouth a mere dent. No attempt to represent either hair or head-dress. Genital organs well defined, and show no trace of circumcision. Navel marked by an unnecessarily deep hole. Roughly made, though great care was taken over certain details. Though the right arm is complete, no attempt was made to represent a hand, and with very little missing it is clear that both the feet were similarly undefined. The curious attitude of this figure cannot be considered accidental since the posture of the legs is the same as no. 2", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/073-008-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-70" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 305, "Plate": "075-010-X", "Block": 9, "House": 6, "Room": "34", "Level_ft": -14.4, "Time_Cat": "Intermediate II", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a red slip. From its lightness this figure is probabably hollow. What may have been a fan-shaped head-dress is broken off, but there seems to have been a flat wing on either side of it, parts of which remain and are much ornamented. On the arms, one of which is unbroken, there are bangles and armlets, and an anklet is seen on the remaining leg. The ornaments worn round the neck may be bands of material studded with sewn-on ornaments. The nostrils are indicated by two small holes, a rare refinement in this class of figure. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-010-x.png", "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-34" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 306, "Plate": "076-001-X", "Block": 9, "House": 8, "Room": "18", "Level_ft": -13.4, "Time_Cat": "Intermediate II", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. A hollow, horned mask, made in a mould, with a hole on each side just below the ears.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-001-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 307, "Plate": "105-018-X", "Block": 9, "House": 10, "Room": "54", "Level_ft": -11.5, "Time_Cat": "Intermediate I", "Feature": "Lithics", "Type": "Flint Core", "Text": "Flint core. Light grey. A long narrow core, from which small flakes had been struck all round; probably regarded as too attenuated to allow of further pieces being struck from it. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-54" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 308, "Plate": "104-001-X", "Block": 9, "House": 6, "Room": "79", "Level_ft": -9.0, "Time_Cat": "Late III", "Feature": "Lithics", "Type": "Mace-heads", "Text": "Hard, dark grey stone. Carefully made, but not exactly round. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-79" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 309, "Plate": "142-002-X", "Block": 9, "House": 7, "Room": "17", "Level_ft": -14.4, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Bullse", "Text": "Light red pottery; no slip. Two rows of pricking round the edge of the obverse, which had a round flat pellet added in the centre before being baked. Two holes for suspension. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-17" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 311, "Plate": "074-015-X", "Block": 7, "House": 3, "Room": "39", "Level_ft": -9.0, "Time_Cat": "Late III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a red slip. The large carrings worn by this figurine of a woman are represented by circular strips of clay. This cap was secured to the head by a fillet, or perhaps the band may represent the loweredge of the cap itself. The lack of slip on this part of the fiure suggests that it was intended to represent a cap made of a white material. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/074-015-x.png", "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-39" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 315, "Plate": "141-061-X", "Block": 9, "House": 11, "Room": "72", "Level_ft": -10.4, "Time_Cat": "Intermediate I", "Feature": "Personal Ornament", "Type": "Beads", "Text": "Steatite", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137032386559781, "y": 27.327186452732171, "j_id": "9-11-72" }, "geometry": { "type": "Point", "coordinates": [ 68.137032386559781, 27.327186452732171 ] } },
{ "type": "Feature", "properties": { "field_1": 321, "Plate": "075-002-X", "Block": 7, "House": 8, "Room": "28", "Level_ft": -22.7, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with traces of a red slip. This figure, which is perhaps that of a woman, holds to its breast around object which may be a dum. There is the usual fan-shaped head-dress and a fillet is worn round the forehead. The remaining leg is short and appears to be deformed. A slight, but unfortunately, broken projection behind the neck suggests that the hair was worn in a knot behind the head. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-002-x.png", "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-28" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 327, "Plate": "075-008-X", "Block": 7, "House": 5, "Room": "51", "Level_ft": -12.0, "Time_Cat": "Intermediate I", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. The single necklace is unfortunately broken. A cone worn on the top of the head just in front of the head-dress is exactly like that commonly worn by the women of the Punjab at the present day.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-008-x.png", "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-51" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 329, "Plate": "140-045-X", "Block": 9, "House": 7, "Room": "51", "Level_ft": -10.5, "Time_Cat": "Intermediate I", "Feature": "Personal Ornament", "Type": "Finger-Ring", "Text": "Double coil of copper or bronze wire. Its two ends do not pass one another in the second coil. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-51" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 331, "Plate": "075-012-X", "Block": 7, "House": 9, "Room": "31", "Level_ft": -13.4, "Time_Cat": "Intermediate II", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. Similar in all essential respects to No. 7 on the same plate. The breasts are, however, more pendant and the infant is hardly recognisable as such. This figurineis hollow and very roughly made. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-012-x.png", "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-31" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 332, "Plate": "111-090-X", "Block": 7, "House": 8, "Room": "22", "Level_ft": -16.3, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Shell-ladles", "Text": "Very well finshed. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-22" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 333, "Plate": "142-045-X", "Block": 7, "House": 1, "Room": "9", "Level_ft": -28.1, "Time_Cat": "Early Periods", "Feature": "Vessels", "Type": "Vessel", "Text": "Greenish-grey steatite. Slightly curved fragment of a vessel which probably had two compartments.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-9" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 337, "Plate": "111-080-X", "Block": 7, "House": 8, "Room": "25", "Level_ft": -19.7, "Time_Cat": "Intermediate III", "Feature": "Household Objects", "Type": "Hammer Stone", "Text": "This spherical object is of flint. It is probably a natural nodule that was trimmed over with some pointed tool to serve as a hammer-stone, for it had been badly knocked about here and there. ", "N1": "Artefacts", "Class": "Other", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-25" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 338, "Plate": "075-019-X", "Block": 7, "House": 4, "Room": "49", "Level_ft": -15.0, "Time_Cat": "Intermediate II", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. Hollow pottery head and shoulders of a woman with very prominent breasts. The sides of the fan-shaped head-dress are swathed with twisted and ornamented bands of material. Below two necklaces fairly close round the throat there is a long thin scarf which seems to be fastened to a girdle by a medallion just though the modelling in general is rough, and an impression is conveyed of a wealthy woman who was fond of good living. Though the figure is hollow, the walls are very thick, and it is not well baked. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-019-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-49" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 343, "Plate": "140-061-X", "Block": 9, "House": 6, "Room": "79", "Level_ft": -6.1, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Stud for nose", "Text": "This stud is unusual in that the pattern is not the stereotyped devided circle; it has a hole right through it from front to back", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-79" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 344, "Plate": "109-020-X", "Block": 7, "House": 8, "Room": "26", "Level_ft": -16.4, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Whestones", "Text": "Made of pottery covered thickly all over with a gritty substance, resembling emery in colour at least. One end is missing and in the other there is a rough hole for a cord. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-26" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 347, "Plate": "076-005-X", "Block": 7, "House": 4, "Room": "69", "Level_ft": -23.1, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a red slip. The bust of a woman as shown by the prominent breasts. The two pairs of horns of which the hinder ones are borken, may  from their somewhat bird-like form have been intended to represent doves perched on the head of a female deity. A figurine is very roughly made and it lacks the usual jewellery indicated by strips and pellets of clay. In their place a necklace was represented in white paint. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-005-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-69" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 349, "Plate": "079-027-X", "Block": 7, "House": 1, "Room": "14", "Level_ft": -26.1, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a cream slip. Carefully made model of a bull with the wrinkles above the neck carefully delineated. Horns nearly complete. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-027-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-14" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 350, "Plate": "076-008-X", "Block": 7, "House": 8, "Room": "25", "Level_ft": -22.1, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with traces of red applied over a thick pinkish slip. Two pottery faces, apparently made in the same mould, were joined together back to back to make this Janus-like head, the material squeezed up between them serving to represent a head-dress. THis double head appears to have been attached to a single body, as the base of the joined becks shows a definitely single fracture. The slanting eyes seem to have been touched up with a graver. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-008-x.png", "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-25" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 351, "Plate": "076-009-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -20.4, "Time_Cat": "[check data]", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a cream slip. This face was made in a mould and the head-dress added afterwards. A joint can be distinguished all round the face. The eyes are Mongolian in characer, and the high cheek bones characteristic of that race are well accentuated. Whether the smile is inentional, it is difficult to say. The high head-dress suggests a woman, though the face itself is more like that of a man. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-009-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 352, "Plate": "076-010-X", "Block": 7, "House": 5, "Room": "68", "Level_ft": -21.5, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. A roughly modelled figure, probably that of a woman, with the hair hanging down the back. THis figure is unusual in that it is fixe on a pottery stand. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-010-x.png", "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-68" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 355, "Plate": "076-013-X", "Block": 10, "House": 1, "Room": "11", "Level_ft": -20.7, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a red slip. Upper part of the figure of a woman holding a child to her left breast. The tall head-dress has a medallion on side and the fracture where another has broken off on the other side. These two medallions were connected by a strip of clay. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-013-x.png", "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-11" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 358, "Plate": "142-023-X", "Block": 7, "House": 8, "Room": "53", "Level_ft": -18.1, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Bracelet", "Text": "Round copper wire. Closely meeting square-cut ends. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-53" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 359, "Plate": "076-017-X", "Block": 7, "House": 8, "Room": "28", "Level_ft": -20.8, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. This is a seated female(?) figure with the feet projecting very slightly. As the base is flat and the figure quite stable, it is possible that it is a piece used in a board game. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-017-x.png", "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-28" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 368, "Plate": "108-013-X", "Block": 7, "House": 8, "Room": null, "Level_ft": -18.3, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Handle", "Text": "Pottery; no slip. A short handle. Four shallow grooves round the middle", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 369, "Plate": "136-098-X", "Block": 9, "House": 9, "Room": "87", "Level_ft": -4.5, "Time_Cat": "Late Ib", "Feature": "Personal Ornament", "Type": "Bracelet", "Text": "Oval copper wire, ends slightly fined down. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-87" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 375, "Plate": "108-020-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": null, "Time_Cat": null, "Feature": "Lithics", "Type": "Flint Core", "Text": "Had been used as a polisher, for some of the angles are rubbed down quite smooth. Another, larger core found with this one shows no trace of polish or other use. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 381, "Plate": "108-023-X", "Block": 9, "House": 6, "Room": "32", "Level_ft": -19.4, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Rolling-pin", "Text": "Cylindrial. Light red pottery; cream slip. Well baked, but the surface somewhat rough. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-32" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 385, "Plate": "109-027-X", "Block": 7, "House": 8, "Room": "16", "Level_ft": -23.9, "Time_Cat": "Early Periods", "Feature": "Lithics", "Type": "Mace-heads", "Text": "Pottery; badly baked. The slightly bi-conical hole that pierces it is 0.62\" in diameter at its narrowest part. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 386, "Plate": "109-028-X", "Block": 7, "House": 8, "Room": "16", "Level_ft": -24.1, "Time_Cat": "Early Periods", "Feature": "Lithics", "Type": "Mace-heads", "Text": "Cream-coloured, cherty limestone. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 387, "Plate": "109-035-X", "Block": 7, "House": 3, "Room": "43", "Level_ft": -13.0, "Time_Cat": "Intermediate II", "Feature": "Lithics", "Type": "Mace-heads", "Text": "Soft, white limestone.  A shallow, rounded hole such as this would have been useless for affixing the head to a shaft, but judging from the finish of the hole and the surface of the head.", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-43" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 397, "Plate": "136-088-X", "Block": 7, "House": 3, "Room": "47", "Level_ft": -13.8, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Composite Bead", "Text": "One segment only of a composite bead which probably comprised some three or five parts in all when complete. Round in section. THe material is dark green, almost black, seprentine. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-47" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 407, "Plate": "109-033-X", "Block": 9, "House": 6, "Room": "32", "Level_ft": -19.3, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Pottery Cone", "Text": "Very hard baked pottery, now a light chocolate colour. Point missing. Spiral line of dots incised on lower portion. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-32" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 409, "Plate": "076-002-X", "Block": 9, "House": 6, "Room": "78", "Level_ft": -18.6, "Time_Cat": "Intermediate III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery; no slip. A hollow mask with holes at the sides for tying it on; very similar to others found in the lower levels, but surmounted with spiral horns, possibly those of a goat, instead of the usual bovine ones. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-002-x.png", "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-78" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 412, "Plate": "140-048-X", "Block": 7, "House": 4, "Room": null, "Level_ft": -8.7, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Finger-Ring", "Text": "Slightly flattened copper wire", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 415, "Plate": "142-011-X", "Block": 7, "House": 8, "Room": "21", "Level_ft": -13.5, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Finger-Ring", "Text": "Round copper wire.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-21" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 419, "Plate": "109-001-X", "Block": 9, "House": 7, "Room": "47", "Level_ft": -20.0, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Cake-mould", "Text": "Pottery; light red in colour and containing a little mica. This cake-mould is quite a new shape, rectangular in outline with rounded corners. The base was only roughly finished, but the interior of the mould had been carefully smoothed over. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-47" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 420, "Plate": "140-050-X", "Block": 7, "House": 7, "Room": "79", "Level_ft": -6.4, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Finger-Ring", "Text": "Four coils of copper or bronze wire. The ends of the wire are turned inside the coils. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137352504566749, "y": 27.326651737149003, "j_id": "7-7-79" }, "geometry": { "type": "Point", "coordinates": [ 68.137352504566749, 27.326651737149003 ] } },
{ "type": "Feature", "properties": { "field_1": 422, "Plate": "140-055-X", "Block": 7, "House": 5, "Room": "63", "Level_ft": -7.3, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Finger-Ring", "Text": "Three coils of copper or bronze wire. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-63" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 426, "Plate": "075-013-X", "Block": 7, "House": 8, "Room": null, "Level_ft": -18.2, "Time_Cat": "Intermediate III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a red slip. A dancing figure with short, squat legs, wearing a scarf and a fillet round the head but otherwise nude. The head-dress suggests that it is meant to represent a woman, though no breasts are indicated. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-013-x.png", "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 432, "Plate": "079-003-X", "Block": 9, "House": 7, "Room": "48", "Level_ft": -18.5, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Rhinoceros, roughly made; no plastic additions, though rough incisions indicate the holds round the neck. Horn missing. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-003-x.png", "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-48" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 437, "Plate": "109-053-X", "Block": 9, "House": 8, "Room": "16", "Level_ft": -19.8, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Tube", "Text": "Curved tube of pottery, with a smooth, red slip. Well made, but one end is missing. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 438, "Plate": "109-042-X", "Block": 7, "House": 9, "Room": "29", "Level_ft": -16.1, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Flesh-rubber", "Text": "Pottery. Flat face, rounded back. Very worn.", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 440, "Plate": "109-003-X", "Block": 7, "House": 9, "Room": "34", "Level_ft": -19.6, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Pottery of unkown use", "Text": "An ivory head which was obviously once fitted into something, which may have been a wooden box. Much polished by use, and it is possible that a string was wound around two of these objects, one in the lid and one just below it in the side of a box, to keep it tightly closed. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137113588928116, "y": 27.326808660204556, "j_id": "7-9-34" }, "geometry": { "type": "Point", "coordinates": [ 68.137113588928116, 27.326808660204556 ] } },
{ "type": "Feature", "properties": { "field_1": 441, "Plate": "091-028-X", "Block": 9, "House": 6, "Room": "36", "Level_ft": -9.1, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Ivory. Point missing. Plain head, projecting slightly on one side. Much polished by use. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-36" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 442, "Plate": "140-053-X", "Block": 10, "House": 3, "Room": "64", "Level_ft": -5.7, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Bracelet", "Text": "Round Copper wire", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-64" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 443, "Plate": "140-060-X", "Block": 7, "House": 4, "Room": "72", "Level_ft": -7.7, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Bracelet", "Text": "Half-round Copper Wire", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-72" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 444, "Plate": "140-062-X", "Block": 7, "House": 4, "Room": "72", "Level_ft": -7.7, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Bracelet", "Text": "Rounded Copper Wire. Ends slightly fined and almost touhing.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-72" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 449, "Plate": "091-033-X", "Block": 9, "House": 9, "Room": "62", "Level_ft": -8.5, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Steatite hair-pin head. Design deeply cut, and evidently intended to be inlaid with coloured paste.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-62" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 450, "Plate": "140-057-X", "Block": 7, "House": 6, "Room": "60", "Level_ft": -3.1, "Time_Cat": "Late Ia", "Feature": "Personal Ornament", "Type": "Bracelet", "Text": "Fragment, blue vitroues paste, decorated on the outside with an incised chevron patter. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137454723356953, "y": 27.326652368157955, "j_id": "7-6-60" }, "geometry": { "type": "Point", "coordinates": [ 68.137454723356953, 27.326652368157955 ] } },
{ "type": "Feature", "properties": { "field_1": 452, "Plate": "109-050-X", "Block": 9, "House": 8, "Room": "16", "Level_ft": -19.8, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Flesh-rubber", "Text": "Pottery. Flat face, rounded back. Very worn.", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 454, "Plate": "076-026-X", "Block": 9, "House": 8, "Room": "18", "Level_ft": -16.6, "Time_Cat": "Intermediate III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with traces of a red slip. This very unusual object consists of a somewhat irregular plaque with a flat, smooth base and slightly rounded upper surface, from one end of which there projects strip of clay for the mouth. Slightly beyond this head the plaque terminates in the head of a bull-like animal, whose horns have unfortunately been broken off. These two heads face in opposite directions. The base of the plaque is smooth, but it seems never to have been coloured red, and it may have been affixed to a clay body to represent the multi-headed animals that are sometimes, though rarely, depicted on the seals; or it may have served to ornament a jar, though we have not as yet found a jar so decorated. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-026-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 456, "Plate": "091-030-X", "Block": 9, "House": 11, "Room": "75", "Level_ft": -8.4, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Button", "Text": "Faience, with traces of blue glaze. Obverse slightly rounded, with boss in centre and a double amrginal row of pittings. Reverse concave, and bridged across by a thin strip. Hand-made; not mounded. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137032386559781, "y": 27.327186452732171, "j_id": "9-11-75" }, "geometry": { "type": "Point", "coordinates": [ 68.137032386559781, 27.327186452732171 ] } },
{ "type": "Feature", "properties": { "field_1": 458, "Plate": "142-019-X", "Block": 7, "House": 8, "Room": "20", "Level_ft": -14.6, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Bracelet (stoneware)", "Text": "Fragment. Dark grey throughout.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-20" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 459, "Plate": "142-024-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -20.4, "Time_Cat": "[check data]", "Feature": "Personal Ornament", "Type": "Bracelet (stoneware)", "Text": "Fragment. Dark grey throughout.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 460, "Plate": "142-025-X", "Block": 4, "House": 0, "Room": "8", "Level_ft": -20.4, "Time_Cat": "[check data]", "Feature": "Personal Ornament", "Type": "Bracelet (stoneware)", "Text": "Fragment. Dark grey throughout.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-8" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 467, "Plate": "091-035-X", "Block": 9, "House": 4, "Room": "6", "Level_ft": -6.8, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Button", "Text": "Steatite with slight traces of green glaze. Obverse slightly rounded, reverse flat with converging holes. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136960165735644, "y": 27.326984249612284, "j_id": "9-4-6" }, "geometry": { "type": "Point", "coordinates": [ 68.136960165735644, 27.326984249612284 ] } },
{ "type": "Feature", "properties": { "field_1": 470, "Plate": "136-070-X", "Block": 9, "House": 10, "Room": "55", "Level_ft": -3.9, "Time_Cat": "Late Ib", "Feature": "Personal Ornament", "Type": "Ornament ( not determined)", "Text": "Shell. Flat shell disc with an incised design on one side only. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-55" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 471, "Plate": "138-018-X", "Block": 9, "House": 10, "Room": "86", "Level_ft": -6.5, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Ornament ( not determined)", "Text": "Faience; faint yellow glaze. Obverse rounded; reverse flat. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-86" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 472, "Plate": "100-001-X", "Block": 10, "House": 1, "Room": null, "Level_ft": -26.2, "Time_Cat": "Early Periods", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Ivory. Flat top, simply decorated on both sides with incised lines. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 473, "Plate": "140-039-X", "Block": 9, "House": 8, "Room": "16", "Level_ft": -14.5, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Ornament ( not determined)", "Text": "Vitreous paste; now cream coloured. Two small holes at the middle, somewhat roughly made. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 474, "Plate": "100-003-X", "Block": 7, "House": 5, "Room": "51", "Level_ft": -12.0, "Time_Cat": "Intermediate I", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Bronze; badly corroded and bent. Surmounted by two head whose spiral horns show them to represent the black buck, in the Bikanir desert. This particular pin affords a proof that was not used to fasten the clothing, for the horns which were originally vertical would have been seriously in the way. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-51" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 475, "Plate": "100-010-X", "Block": 7, "House": 5, "Room": "51", "Level_ft": -12.0, "Time_Cat": "Intermediate I", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Bronze; badly corroded and bent. Surmounted by two head whose spiral horns show them to represent the black buck, in the Bikanir desert. This particular pin affords a proof that was not used to fasten the clothing, for the horns which were originally vertical would have been seriously in the way. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-51" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 477, "Plate": "100-005-X", "Block": 7, "House": 4, "Room": "49", "Level_ft": -14.9, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Hair-pin", "Text": "Bone. Point missing. Roughly made, and not perfectly round. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-49" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 480, "Plate": "140-040-X", "Block": 9, "House": 8, "Room": "16", "Level_ft": -6.4, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Ornament ( not determined)", "Text": "Faience, formerly glazed. Fan-shaped. Obverse ornamented with an unusually regular and delicate incised design; reverse plain and flat. A tiny hole at the top of the fan-shaped edge and another at the point below. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-16" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 481, "Plate": "075-018-X", "Block": 10, "House": 0, "Room": null, "Level_ft": -17.7, "Time_Cat": "Intermediate III", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with traces of a red wash. This is a side view of the head and shoulders of a female figure wearing tight necklaces, apparently of double strings of beads, and very unusual ornaments on either side of the head. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/075-018-x.png", "x": 68.136818531950922, "y": 27.326713129436506, "j_id": "10-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.136818531950922, 27.326713129436506 ] } },
{ "type": "Feature", "properties": { "field_1": 482, "Plate": "100-012-X", "Block": 10, "House": 0, "Room": null, "Level_ft": -16.9, "Time_Cat": "Intermediate III", "Feature": "Personal Ornament", "Type": "Stud for nose", "Text": "Faience, with no trace left of colour.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136818531950922, "y": 27.326713129436506, "j_id": "10-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.136818531950922, 27.326713129436506 ] } },
{ "type": "Feature", "properties": { "field_1": 483, "Plate": "079-007-X", "Block": 10, "House": 1, "Room": "2", "Level_ft": -18.3, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; traces of red slip. Model of animal which is difficult to identify. Not an elephant, as it never had a trunk. The prominent ears, now broken, suggest a hare. Hollow, though not a rattle. The corpulent, over-fed look of this model suggests that the hare, if it be this animal, was sometimes kept as a pet. The very small tail is held to one side and not upright, as is normally the case in hares and rabbits. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-007-x.png", "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-2" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 494, "Plate": "143-003-X", "Block": 10, "House": 1, "Room": "5", "Level_ft": -16.0, "Time_Cat": "Intermediate III", "Feature": "Vessels", "Type": "Vessel", "Text": "Soft white alabaster. Part of a shallow bowl with a flat edge to the rim, which in shape is like certain bowls of copper and bronze.", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-5" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 495, "Plate": "143-004-X", "Block": 10, "House": 1, "Room": "5", "Level_ft": -16.0, "Time_Cat": "Intermediate III", "Feature": "Vessels", "Type": "Vessel", "Text": "Soft white alabaster. Small fragment of a shallow bowl. Badly corroded. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-5" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
{ "type": "Feature", "properties": { "field_1": 496, "Plate": "140-059-X", "Block": 9, "House": 7, "Room": "21", "Level_ft": -7.5, "Time_Cat": "Late III", "Feature": "Personal Ornament", "Type": "Pectoral", "Text": "Light yellow steatite. Back plain and slightly rounded. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-21" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 501, "Plate": "105-051-X", "Block": 9, "House": 3, "Room": "26", "Level_ft": -11.0, "Time_Cat": "Intermediate I", "Feature": "Tools", "Type": "Rubber", "Text": "It is hard, cherty limestone and is evidently a polisher or rubber of some kind. Thid object is a convenient shape to hold in the hand and may have been used in preparing skins. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-26" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 503, "Plate": "091-032-X", "Block": 10, "House": 4, "Room": "70", "Level_ft": -5.0, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Button", "Text": "Light blue faience. Hemispherical and hollow, with a loop inside the apex. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136571946160444, "y": 27.326689861162478, "j_id": "10-4-70" }, "geometry": { "type": "Point", "coordinates": [ 68.136571946160444, 27.326689861162478 ] } },
{ "type": "Feature", "properties": { "field_1": 505, "Plate": "104-025-X", "Block": 9, "House": 9, "Room": "66", "Level_ft": -6.4, "Time_Cat": "Late II", "Feature": "Tools", "Type": "Large Cone", "Text": "Cream-coloured, cherty limestone. Badly chipped and fractured. Surface soemwhat roughly finished and shows signs of the use of an abrasive  on it, though there was no attempt at polish. Its flat base shows no particular wear, and this may very possibly have been a linqa.", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-66" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 509, "Plate": "139-013-X", "Block": 7, "House": 2, "Room": "92", "Level_ft": -13.3, "Time_Cat": "Intermediate II", "Feature": "Personal Ornament", "Type": "Button", "Text": "White steatite (?) The usual two converging holes. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137268560324117, "y": 27.32683601680181, "j_id": "7-2-92" }, "geometry": { "type": "Point", "coordinates": [ 68.137268560324117, 27.32683601680181 ] } },
{ "type": "Feature", "properties": { "field_1": 511, "Plate": "140-044-X", "Block": 7, "House": 5, "Room": "62", "Level_ft": -6.4, "Time_Cat": "Late II", "Feature": "Personal Ornament", "Type": "Button", "Text": "Blue faienece. Obverse rounded with slight projection in centre, reverse flat, with two converging holes. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-62" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 517, "Plate": "108-006-X", "Block": 9, "House": 6, "Room": "34", "Level_ft": -15.4, "Time_Cat": "Intermediate II", "Feature": "Tools", "Type": "Small cone", "Text": "Though unfinished, there are slight traces of wear at the point. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-34" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 518, "Plate": "104-026-X", "Block": 9, "House": 7, "Room": "18", "Level_ft": -4.8, "Time_Cat": "Late Ib", "Feature": "Tools", "Type": "Pedestal", "Text": "Comparatively soft, dark red stone. The base of this pedestal is flat and semi-polished, with two holes in it, each 1.15\", from the edge and an average of 0.25\" in diameter and 0.4\" deep. A depression which is 2.45\" in diameter and 0.3\" deep in the top. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136843392926821, "y": 27.326818270024919, "j_id": "9-7-18" }, "geometry": { "type": "Point", "coordinates": [ 68.136843392926821, 27.326818270024919 ] } },
{ "type": "Feature", "properties": { "field_1": 522, "Plate": "070-008-X", "Block": 4, "House": 0, "Room": "12", "Level_ft": -12.7, "Time_Cat": "Intermediate I", "Feature": "Pottery - Incised and Painted", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Other", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/070-008-x.png", "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-12" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 523, "Plate": "054-014-X", "Block": 9, "House": 8, "Room": "15", "Level_ft": -10.7, "Time_Cat": "Intermediate I", "Feature": "Tools", "Type": "Flesh-rubber", "Text": "Light red  paste, plentifully mixed with lime and an unusually large proportion of sand to make it rough and gritty. A vent-hole at one end.", "N1": "Artefacts", "Class": "Craft", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/054-014-x.png", "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-15" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 524, "Plate": "105-041-X", "Block": 9, "House": 8, "Room": "15", "Level_ft": -8.9, "Time_Cat": "Late III", "Feature": "Tools", "Type": "Spindle-whorls", "Text": "Shell. The obverse is weathered and now shows no signs of polish. The reverse is concave in places owing to the natural curature of the shell. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-15" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 528, "Plate": "106-022-X", "Block": 9, "House": 1, "Room": "50", "Level_ft": -3.4, "Time_Cat": "Late Ib", "Feature": "Tools", "Type": "Spindle-whorls", "Text": "Vitreous paste; apple-green in colour. Ornamented with shallow flutings. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137252775657217, "y": 27.327018499916552, "j_id": "9-1-50" }, "geometry": { "type": "Point", "coordinates": [ 68.137252775657217, 27.327018499916552 ] } },
{ "type": "Feature", "properties": { "field_1": 534, "Plate": "109-017-X", "Block": 7, "House": 8, "Room": "26", "Level_ft": -25.0, "Time_Cat": "Early Periods", "Feature": "Tools", "Type": "Whestones", "Text": "LIght grey stone resembling slate. Thinner end missing. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-26" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 535, "Plate": "109-039-X", "Block": 10, "House": 3, "Room": "67", "Level_ft": -16.8, "Time_Cat": "Intermediate III", "Feature": "Cooking Baking Utensils", "Type": "Wavy Ring", "Text": "Alabaster. Hole through centre. THe top and bottom of this ring had been quartered by two deep cuts, and the edges of the projections so formed were neatly rounded off. Slightly weathered. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-67" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 536, "Plate": "076-007-X", "Block": 7, "House": 1, "Room": "14", "Level_ft": -30.0, "Time_Cat": "Early Periods", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, with a red slip. Seated figure of a woman wearing a high, tight neckleace, a fillet round the forehead, and apparently long hanging earings-unless these last are ornaments suspended from the fan-shaped head-dress. The size of the head and neck is out of all proportion to the shapeless body. The base of the figure is slightly rounded, but it stands well nevertheless and may have been used in a board game.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/076-007-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-14" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 537, "Plate": "109-046-X", "Block": 9, "House": 6, "Room": null, "Level_ft": -20.4, "Time_Cat": "[check data]", "Feature": "Tools", "Type": "Spindle-whorls", "Text": "Hole in the centre. Somewhat roughly made and cut. The obverse is decorated as seen in the photo; the reverse is quite plain. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 540, "Plate": "105-046-X", "Block": 9, "House": 3, "Room": "30", "Level_ft": -4.5, "Time_Cat": "Late Ib", "Feature": "Tools", "Type": "Spindle-whorls(?)", "Text": "Light red pottery. Three holes in a line, groove round the edge. Hand-made; smooth domed top and slightly concave base. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-30" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 549, "Plate": "108-005-X", "Block": 7, "House": 3, "Room": "43", "Level_ft": -13.0, "Time_Cat": "Intermediate II", "Feature": "Tools", "Type": "Small cone", "Text": "Tip broken, but otherwise the cone shows no evidence of wear. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-43" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 550, "Plate": "105-033-X", "Block": 9, "House": 9, "Room": "63", "Level_ft": -8.4, "Time_Cat": "Late III", "Feature": "Tools", "Type": "Bobbin", "Text": "LIght yellow steatite. There is a deep groove, V-shaped in section, round the circumference. THis well-made object may possibly have been used as a bobbin, though in many respects it strongly resembles a sheave. It is, however, too small and made of too soft a stone for the latter purpose. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-63" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 551, "Plate": "080-002-X", "Block": 10, "House": 3, "Room": null, "Level_ft": -17.4, "Time_Cat": "Intermediate III", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with a red slip. Carefully made figure of a monkey sqautting with hands on knees. Two vertical holes in the top fo the head could not have been intended to take separately-made ears as they are too high up. Another hole of about the same diamter, close behind the head, pierces the figure form top to bottom, and may have been intended.", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-002-x.png", "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
{ "type": "Feature", "properties": { "field_1": 553, "Plate": "109-009-X", "Block": 10, "House": 4, "Room": "71", "Level_ft": -18.2, "Time_Cat": "Intermediate III", "Feature": "Tools", "Type": "Awl", "Text": "Bone Blunt end irregular and flattened Tip of fine point missing. Shows the polish of much use. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136571946160444, "y": 27.326689861162478, "j_id": "10-4-71" }, "geometry": { "type": "Point", "coordinates": [ 68.136571946160444, 27.326689861162478 ] } },
{ "type": "Feature", "properties": { "field_1": 557, "Plate": "104-022-X", "Block": 7, "House": 3, "Room": "52", "Level_ft": -3.5, "Time_Cat": "Late Ib", "Feature": "Tools", "Type": "Pedestal", "Text": "A brownish-yellow, semi-hard stone. The depression in the top was first cut with a tubular drill, the spaces between the holes being removed subsequently with a chisel. The sides of the stand from the base to the top horizontally fluted and this ornamentation, thgouh not entirely accurate, nevertheless carefully done. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-52" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 559, "Plate": "105-010-X", "Block": 9, "House": 12, "Room": "93", "Level_ft": -11.9, "Time_Cat": "Intermediate I", "Feature": "Tools", "Type": "Awl", "Text": "Bone. Roughly rectangular in section, measuring 0.54\" * 0.22\" at the thickest part. Comparatively blunt point showing evidence of much use. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137254080694547, "y": 27.327143212101898, "j_id": "9-12-93" }, "geometry": { "type": "Point", "coordinates": [ 68.137254080694547, 27.327143212101898 ] } },
{ "type": "Feature", "properties": { "field_1": 567, "Plate": "054-012-X", "Block": 7, "House": 4, "Room": "72", "Level_ft": -7.7, "Time_Cat": "Late III", "Feature": "Tools", "Type": "Candle-stick", "Text": "Pottery candle-stick. Made of the usual pink ware with a heavy admixture of sand, mica and lime, but no slip, and is very thick and heavy in make with its flat broad base carefully trimmed. The vertical hole running right through the susbstantial candle-holder in the centre also pierces the base of the stand. Unfortunately, the upper part of the candle-holder is missng and we do not know its shpe; but in its present state the holder still projects above the rim of the dish. ", "N1": "Artefacts", "Class": "Craft", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_1/054-012-x.png", "x": 68.13751733417692, "y": 27.326837552538851, "j_id": "7-4-72" }, "geometry": { "type": "Point", "coordinates": [ 68.13751733417692, 27.326837552538851 ] } },
{ "type": "Feature", "properties": { "field_1": 568, "Plate": "105-006-X", "Block": 9, "House": 9, "Room": "56", "Level_ft": -6.4, "Time_Cat": "Late II", "Feature": "Weights And Measures", "Type": "Spherical with flattened top and base", "Text": "Cream-coloured, cherty limestone. This weight is spherodial with a flat top and base which gradually merge at their edges into the rounded sides. Wall made and finished, smooth but unpolished; in an excellent state of perservation exept for one or two abrasions which affect its weight but little. The holes in it are natural and must have existed when the weight was made. ", "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.136999915436391, "y": 27.327128462476399, "j_id": "9-9-56" }, "geometry": { "type": "Point", "coordinates": [ 68.136999915436391, 27.327128462476399 ] } },
{ "type": "Feature", "properties": { "field_1": 577, "Plate": "111-052-X", "Block": 9, "House": 0, "Room": null, "Level_ft": -20.6, "Time_Cat": "Early Periods", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137133310054224, "y": 27.326970543563384, "j_id": "9-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137133310054224, 27.326970543563384 ] } },
{ "type": "Feature", "properties": { "field_1": 578, "Plate": "136-022-X", "Block": 9, "House": 12, "Room": "92", "Level_ft": -6.3, "Time_Cat": "Late II", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137254080694547, "y": 27.327143212101898, "j_id": "9-12-92" }, "geometry": { "type": "Point", "coordinates": [ 68.137254080694547, 27.327143212101898 ] } },
{ "type": "Feature", "properties": { "field_1": 579, "Plate": "105-049-X", "Block": 7, "House": 8, "Room": "25", "Level_ft": -10.9, "Time_Cat": "Intermediate I", "Feature": "Tools", "Type": "Spindle-whorls", "Text": "Vitreous paste; turquoise-blue in colour. Both ends vary slightly convex, with a slight projection to ornament the obverse. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-25" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 582, "Plate": "136-023-X", "Block": 9, "House": 6, "Room": "36", "Level_ft": -5.8, "Time_Cat": "Late II", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.136914371579238, "y": 27.326887650571138, "j_id": "9-6-36" }, "geometry": { "type": "Point", "coordinates": [ 68.136914371579238, 27.326887650571138 ] } },
{ "type": "Feature", "properties": { "field_1": 586, "Plate": "136-024-X", "Block": 9, "House": 10, "Room": "33", "Level_ft": -9.3, "Time_Cat": "Late III", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-33" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 588, "Plate": "109-055-X", "Block": 7, "House": 5, "Room": "78", "Level_ft": -12.9, "Time_Cat": "Intermediate I", "Feature": "Tools", "Type": "Spindle-whorls", "Text": "Shell. Upper surface carefully polished; under surface slightly concave and in places follows the natural curvature of the shell. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-78" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
{ "type": "Feature", "properties": { "field_1": 592, "Plate": "136-029-X", "Block": 9, "House": 3, "Room": "29", "Level_ft": -1.8, "Time_Cat": "Late Ia", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137231898932455, "y": 27.326929151802382, "j_id": "9-3-29" }, "geometry": { "type": "Point", "coordinates": [ 68.137231898932455, 27.326929151802382 ] } },
{ "type": "Feature", "properties": { "field_1": 594, "Plate": "109-052-X", "Block": 10, "House": 4, "Room": "73", "Level_ft": -13.6, "Time_Cat": "Intermediate II", "Feature": "Tools", "Type": "Spindle-whorls(?)", "Text": "Pottery; heavily fired and now grey-brown in colour. Flat base and domed top.", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.136571946160444, "y": 27.326689861162478, "j_id": "10-4-73" }, "geometry": { "type": "Point", "coordinates": [ 68.136571946160444, 27.326689861162478 ] } },
{ "type": "Feature", "properties": { "field_1": 595, "Plate": "109-054-X", "Block": 7, "House": 3, "Room": "39", "Level_ft": -14.4, "Time_Cat": "Intermediate II", "Feature": "Tools", "Type": "Spindle-whorls(?)", "Text": "Pottery; smoked a dark-grey colour int eh kiln. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-39" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 598, "Plate": "079-017-X", "Block": 7, "House": 1, "Room": "15", "Level_ft": -26.8, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. HUmped bull. Incised work on head; two lines round neck represent a collar or wrinkles in the skin. Both pairs of legs joined. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/079-017-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-15" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 600, "Plate": "136-046-X", "Block": 9, "House": 10, "Room": "81", "Level_ft": -11.5, "Time_Cat": "Intermediate I", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137115564724553, "y": 27.327116095130179, "j_id": "9-10-81" }, "geometry": { "type": "Point", "coordinates": [ 68.137115564724553, 27.327116095130179 ] } },
{ "type": "Feature", "properties": { "field_1": 603, "Plate": "136-047-X", "Block": 9, "House": 8, "Room": "19", "Level_ft": -3.6, "Time_Cat": "Late Ib", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.136864434663195, "y": 27.327119842504313, "j_id": "9-8-19" }, "geometry": { "type": "Point", "coordinates": [ 68.136864434663195, 27.327119842504313 ] } },
{ "type": "Feature", "properties": { "field_1": 610, "Plate": "109-010-X", "Block": 4, "House": 0, "Room": "15", "Level_ft": -20.8, "Time_Cat": "Early Periods", "Feature": "Tools", "Type": "Awl", "Text": "Bone. Very worn and polished. ", "N1": "Artefacts", "Class": "Craft", "photo": null, "x": 68.137481536785629, "y": 27.326571542205492, "j_id": "4-0-15" }, "geometry": { "type": "Point", "coordinates": [ 68.137481536785629, 27.326571542205492 ] } },
{ "type": "Feature", "properties": { "field_1": 612, "Plate": "142-042-X", "Block": 7, "House": 3, "Room": "42", "Level_ft": -21.1, "Time_Cat": "Early Periods", "Feature": "Vessels", "Type": "Vessel", "Text": "Steatite or steatite paste. This little vessel is not complete; it had once een fitted on a base of some kind. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-42" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 613, "Plate": "142-043-X", "Block": 7, "House": 8, "Room": "28", "Level_ft": -14.8, "Time_Cat": "Intermediate II", "Feature": "Vessels", "Type": "Vessel", "Text": "Soft white alabaster. This jar was made in three pieces; the rim and shoulder, the body, and a base is missing. The ipper part was made in two pieces to allow of a reasonable-sized avity being drilled in the body; this would not have been possible if the vase had been made in one piece. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-28" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 615, "Plate": "080-016-X", "Block": 7, "House": 1, "Room": "15", "Level_ft": -26.2, "Time_Cat": "Early Periods", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery; no slip. Head of a brid; which its broad flat bill, either a duck or a spoonbill. There is a samll vertical hole through the neck. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-016-x.png", "x": 68.137158520876298, "y": 27.326731938535811, "j_id": "7-1-15" }, "geometry": { "type": "Point", "coordinates": [ 68.137158520876298, 27.326731938535811 ] } },
{ "type": "Feature", "properties": { "field_1": 618, "Plate": "143-002-X", "Block": 7, "House": 5, "Room": "66", "Level_ft": -12.5, "Time_Cat": "Intermediate I", "Feature": "Vessels", "Type": "Vessel", "Text": "Soft white alabaster. Part of a shallow dish with a ring base. The drawing is reconstruction from the small fragment found. Badly corroded. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.137439408488007, "y": 27.32672157283957, "j_id": "7-5-66" }, "geometry": { "type": "Point", "coordinates": [ 68.137439408488007, 27.32672157283957 ] } },
