{ "type": "Feature", "properties": { "field_1": 1002, "Plate": "139-096-X", "Block": 7, "House": 6, "Room": "74", "Level_ft": -14.4, "Time_Cat": "Intermediate II", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137454723356953, "y": 27.326652368157955, "j_id": "7-6-74" }, "geometry": { "type": "Point", "coordinates": [ 68.137454723356953, 27.326652368157955 ] } },
{ "type": "Feature", "properties": { "field_1": 1003, "Plate": "077-022-X", "Block": 10, "House": 4, "Room": null, "Level_ft": -11.3, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Pottery, with traces of a red wash. An unusally complete model of a rhinoceros. The ears are rather larger than they should be, though their form is correct. The eyes are represented by pellets and the mouth by a gash. The heavy folds of skin-like armour-plate which are characteristic of this anumal are indicated by broad strips of clay pricked all over to represent its peculiar warty exerescenes. The tail is missing. Two rough vertical incisions on each side of the body represent other folds of skin. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/077-022-x.png", "x": 68.136571946160444, "y": 27.326689861162478, "j_id": "10-4-" }, "geometry": { "type": "Point", "coordinates": [ 68.136571946160444, 27.326689861162478 ] } },
{ "type": "Feature", "properties": { "field_1": 1006, "Plate": "139-100-X", "Block": 7, "House": 0, "Room": null, "Level_ft": -21.1, "Time_Cat": "Early Periods", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137364548270739, "y": 27.326720723930944, "j_id": "7-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.137364548270739, 27.326720723930944 ] } },
{ "type": "Feature", "properties": { "field_1": 1008, "Plate": "139-063-X", "Block": 7, "House": 3, "Room": "43", "Level_ft": -18.1, "Time_Cat": "Intermediate III", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-43" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
{ "type": "Feature", "properties": { "field_1": 1009, "Plate": "139-103-X", "Block": 7, "House": 8, "Room": "53", "Level_ft": -17.8, "Time_Cat": "Intermediate III", "Feature": "Beads", "Type": null, "Text": null, "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.137289073956595, "y": 27.326731644637857, "j_id": "7-8-53" }, "geometry": { "type": "Point", "coordinates": [ 68.137289073956595, 27.326731644637857 ] } },
{ "type": "Feature", "properties": { "field_1": 1011, "Plate": "080-003-X", "Block": 10, "House": 1, "Room": "5", "Level_ft": -12.6, "Time_Cat": "Intermediate I", "Feature": "Animals", "Type": "Model animal", "Text": "Porous white paste. Roughly modelled figure of monkey, squatting with hands on knees. The paste of which it is made appears to be powdered steatite, and as no trace of glaze remains, we must conclude that this mdoel was never finished. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/080-003-x.png", "x": 68.136957340395242, "y": 27.326673394270657, "j_id": "10-1-5" }, "geometry": { "type": "Point", "coordinates": [ 68.136957340395242, 27.326673394270657 ] } },
