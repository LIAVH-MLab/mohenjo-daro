{ "type": "Feature", "properties": { "field_1": 689, "Plate": "072-007-X", "Block": 10, "House": 3, "Room": null, "Level_ft": -11.2, "Time_Cat": "Intermediate I", "Feature": "Human Figure", "Type": "Figurine", "Text": "Pottery, once coated with a red slip. The eyes are as usual flat, elongated pellets, the mouth an incised strup of clay set in a deep cut. A short necklet, from which four ornaments hang in front, appears to represent two strings of beads. The long scarf round the neck, with its two ends apparently fastened by a brooch, hangs so loosely that it much represent some kind of woven material. This figurine, obviousy that of a male, wears the horns of a bull. There are no ears and though the figure was evidently carefully made there is a general absence of detail. ", "N1": "Artefacts", "Class": "Domestic", "photo": "https://raw.githubusercontent.com/PrattSAVI/LIAVH/master/images_2/072-007-x.png", "x": 68.136727574985898, "y": 27.326675614898654, "j_id": "10-3-" }, "geometry": { "type": "Point", "coordinates": [ 68.136727574985898, 27.326675614898654 ] } },
