{ "type": "Feature", "properties": { "field_1": 627, "Plate": "111-081-X", "Block": 7, "House": 3, "Room": "25", "Level_ft": -8.1, "Time_Cat": "Late III", "Feature": "Weights And Measures", "Type": "Cubed-shaped weight", "Text": "Unfinsihed cube-weight of grey-chert. It had been carefully chipped into shape, but the flakings were never ground way", "N1": "Artefacts", "Class": "Trade", "photo": null, "x": 68.13739207321504, "y": 27.326790579853032, "j_id": "7-3-25" }, "geometry": { "type": "Point", "coordinates": [ 68.13739207321504, 27.326790579853032 ] } },
