{ "type": "Feature", "properties": { "field_1": 2496, "Plate": "105-038-X", "Block": 10, "House": 0, "Room": null, "Level_ft": -10.0, "Time_Cat": "Intermediate I", "Feature": "Cooking Baking Utensils", "Type": "Writing-tablet", "Text": "LIght red pottery; no slip.There is a hole through the handle for a suspension. ", "N1": "Artefacts", "Class": "Domestic", "photo": null, "x": 68.136818531950922, "y": 27.326713129436506, "j_id": "10-0-" }, "geometry": { "type": "Point", "coordinates": [ 68.136818531950922, 27.326713129436506 ] } },
